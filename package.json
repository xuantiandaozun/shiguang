{
  "name": "shiguang",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:browser-operations": "node --test scripts/test-page-operations.mjs",
    "test:browser-runtime": "node --test scripts/test-browser-runtime.mjs",
    "test:recorder-page": "node --test scripts/test-page-recorder.mjs",
    "test:browser-e2e": "node --test --test-timeout=30000 scripts/test-browser-runtime-e2e.mjs",
    "sidecar:dev": "node scripts/build-index-helper.mjs dev",
    "sidecar:build": "node scripts/build-index-helper.mjs release",
    "pack:extension": "node scripts/pack-browser-extension.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle && node scripts/sync-plugins.mjs src-tauri/target/release",
    "tauri:bundle": "tauri build --config src-tauri/tauri.plugins.conf.json",
    "release:local": "tauri build --config src-tauri/tauri.local-bundle.conf.json --config src-tauri/tauri.plugins.conf.json",
    "plugins:sync": "node scripts/sync-plugins.mjs src-tauri/target/release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
