{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾光",
  "version": "0.1.1",
  "identifier": "com.deskhelper.win",
  "build": {
    "beforeDevCommand": "npm run sidecar:dev && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floatball",
        "title": "拾光-ball",
        "width": 76,
        "height": 76,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true,
        "url": "/#/floatball"
      },
      {
        "label": "chat",
        "title": "拾光-chat",
        "width": 400,
        "height": 620,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "url": "/#/chat"
      },
      {
        "label": "reminder",
        "title": "拾光-reminder",
        "width": 384,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "url": "/#/reminder"
      },
      {
        "label": "main",
        "title": "拾光 · AI 桌面助手",
        "width": 960,
        "height": 660,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false,
        "url": "/#/main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/shiguang-index-helper"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "category": "Utility",
    "shortDescription": "拾光 - AI 桌面助手",
    "longDescription": "拾光 —— 常驻 Windows 托盘的 AI 桌面助手：整理桌面文件、待办准时提醒、操作浏览器。"
  }
}
