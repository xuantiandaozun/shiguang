[
  {
    "name": "workspace_list",
    "label": "查看工作区",
    "description": "列出已登记的工作区（固定项目），含当前会话绑定的是哪个。",
    "parameters": {
      "properties": {},
      "type": "object"
    }
  },
  {
    "name": "workspace_open",
    "label": "打开工作区",
    "category": "core",
    "description": "把工作区绑定到当前会话并读取详情：登记的部署/验证/工具/规则/经验，加上现读的 git 分支、未提交改动、最近提交和项目说明开头。绑定后未给 workdir 的命令默认在其根目录执行。",
    "parameters": {
      "properties": {
        "workspace": {
          "description": "名称、别名或 id"
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_detect",
    "label": "识别项目",
    "description": "从项目文件夹推断工作区草稿（名称、技术栈、验证命令、部署线索、git 远端、说明文件）。只读不保存。",
    "parameters": {
      "properties": {
        "root": {
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "type": "object"
    }
  },
  {
    "name": "workspace_save",
    "label": "保存工作区",
    "description": "新建或更新工作区。会弹确认卡片，用户同意才写入。适合在完成一个固定项目的任务后，把用户给过的路径、部署方式、配套工具、规则整理进去，下次说名字就能直接用。只写仓库里读不到的信息，不写密钥内容。更新时只传要改的字段。",
    "parameters": {
      "properties": {
        "agent_mode": {
          "description": "默认外派权限：plan 只出方案；edit 可改文件跑命令（默认）；full 跳过确认",
          "enum": [
            "plan",
            "edit",
            "full"
          ],
          "type": "string"
        },
        "aliases": {
          "description": "用户可能的叫法：中文名、英文名、域名、仓库名",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "append_notes": {
          "description": "追加经验（任务中确认过的、下次还用得上的事实）",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_agent": {
          "description": "默认外派给谁",
          "enum": [
            "claude_code",
            "codex"
          ],
          "type": "string"
        },
        "deploy": {
          "description": "怎么上线、有什么后果，如「push main 即 Vercel 自动部署」",
          "type": "string"
        },
        "links": {
          "items": {
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "description": "工作区名称；已存在则更新",
          "type": "string"
        },
        "notes": {
          "description": "整表替换经验；只想追加用 append_notes",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "项目根目录绝对路径（新建必填）",
          "type": "string"
        },
        "rules": {
          "description": "必须遵守的规则，如「push 前先问我」",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "description": "一句话：是什么项目、技术栈、内容从哪来",
          "type": "string"
        },
        "tools": {
          "description": "配套 CLI 及其路径、配置文件路径（只写路径，不写密钥内容）",
          "type": "string"
        },
        "verify_commands": {
          "description": "验证命令，如 npm run build",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  }
]
