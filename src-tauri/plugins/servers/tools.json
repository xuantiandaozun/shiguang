[
  {
    "name": "list_servers",
    "label": "查看服务器",
    "description": "列出本地服务器连接，不返回密码。",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "get_server",
    "label": "读取连接",
    "description": "读取一项本地服务器连接，不返回密码。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "create_server",
    "label": "新增服务器",
    "description": "新增本地 SSH 连接。secret 为密码或私钥口令。首次连接需要用户在拾光服务器页核对并信任指纹。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "enum": [
            "password",
            "key",
            "agent"
          ],
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "private_key": {
          "type": "string"
        },
        "secret": {
          "description": "密码或私钥口令，仅写入；省略保留，空串清除。已有凭据不会返回。",
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "host",
        "username",
        "auth"
      ],
      "type": "object"
    }
  },
  {
    "name": "update_server",
    "label": "修改服务器",
    "description": "修改本地连接，仅更新提供的字段。修改地址、端口会清除指纹信任。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "enum": [
            "password",
            "key",
            "agent"
          ],
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "private_key": {
          "type": "string"
        },
        "secret": {
          "description": "密码或私钥口令，仅写入；省略保留，空串清除。已有凭据不会返回。",
          "type": "string"
        },
        "server_id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "server_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "delete_server",
    "label": "删除连接",
    "description": "删除本地连接及凭据，不删除远程文件。运行中任务存在时拒绝删除。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "test_server_connection",
    "label": "测试连接",
    "description": "检查 SSH 主机指纹；未信任时不发送凭据，返回待确认的指纹。已信任则测试登录。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "ssh_exec",
    "label": "执行远程命令",
    "description": "启动远程非交互命令，返回 task_id。每次独立 Shell；需明确工作目录。用 wait_remote_task 等待结果。破坏性操作须有用户授权。超时/取消仅断开连接，远程进程可能继续，勿自动重试。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "workdir": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "command"
      ],
      "type": "object"
    }
  },
  {
    "name": "sftp_list",
    "label": "浏览远程目录",
    "description": "列出远程目录，返回解析后的绝对 path、entries 及 truncated；最多 2000 项。后续路径可基于返回的 path 拼接。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "remote_path": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "remote_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "sftp_stat",
    "label": "查看远程文件",
    "description": "读取远程路径元数据。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "remote_path": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "remote_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "sftp_upload",
    "label": "上传文件",
    "description": "上传单个文件或目录到精确远程路径（目录目标为根目录）；拒绝跟随符号链接。默认拒绝覆盖。先传临时文件，完成后重命名。返回 task_id。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "local_path": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        },
        "remote_path": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "local_path",
        "remote_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "sftp_download",
    "label": "下载文件",
    "description": "下载文件或目录到本机绝对路径（目录目标为根目录）；拒绝符号链接，默认拒绝覆盖。返回 task_id。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "local_path": {
          "type": "string"
        },
        "overwrite": {
          "type": "boolean"
        },
        "remote_path": {
          "type": "string"
        },
        "server_id": {
          "type": "string"
        }
      },
      "required": [
        "server_id",
        "local_path",
        "remote_path"
      ],
      "type": "object"
    }
  },
  {
    "name": "list_remote_tasks",
    "label": "查看远程任务",
    "description": "列出远程命令及传输任务，不返回命令正文。",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "required": [],
      "type": "object"
    }
  },
  {
    "name": "get_remote_task",
    "label": "读取远程结果",
    "description": "查询任务、传输字节数及日志尾部。output_offset 可按字节读取日志，返回 next_offset；日志可能包含敏感命令输出。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "output_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "wait_remote_task",
    "label": "等待远程任务",
    "description": "挂起等待原任务，最长 60 秒；仍 running 时继续等待原 task_id。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "output_offset": {
          "minimum": 0,
          "type": "integer"
        },
        "task_id": {
          "type": "string"
        },
        "timeout_seconds": {
          "maximum": 60,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    }
  },
  {
    "name": "cancel_remote_task",
    "label": "取消远程任务",
    "description": "取消本地等待或传输并断开 SSH；远程命令可能仍运行，需核实实际状态。",
    "parameters": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "type": "object"
    }
  }
]
