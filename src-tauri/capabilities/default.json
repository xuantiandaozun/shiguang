{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability for all windows",
  "windows": ["floatball", "chat", "main", "reminder"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "notification:default",
    "autostart:default",
    "dialog:allow-open"
  ]
}
